# LLM Provider Configuration
# Supported providers: "groq" | "google" | "openai" | "anthropic" | "mock"
# If no API key is set, the harness gracefully falls back to deterministic Neuro-Symbolic Guided Mode.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# Provider API Keys (set the one matching LLM_PROVIDER)
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
