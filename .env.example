# LLM Provider Configuration
# Supported providers: "google" | "openai" | "anthropic" | "mock"
# If no API key is set, the harness gracefully falls back to deterministic Neuro-Symbolic Guided Mode.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash

# Provider API Keys (set the one matching LLM_PROVIDER)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
